#!/usr/bin/env bash

set -euo pipefail

jwt_project=${1:-}
jwt_env_file=${2:-}

if [[ -z $jwt_project || -z $jwt_env_file ]]; then
    echo "Usage: $0 <project> <environment-file>" >&2
    exit 2
fi

get_live_jwt_ids() {
    local now tokens
    now=$(date -u +%s)
    tokens=$(dotnet user-jwts list --project "$jwt_project" --output json)
    jq -r --argjson now "$now" '
        .[]
        | select(
            (.NotBefore | sub("\\+00:00$"; "Z") | fromdateiso8601) <= $now
            and (.Expires | sub("\\+00:00$"; "Z") | fromdateiso8601) > $now
        )
        | .Id
    ' <<< "$tokens"
}

mapfile -t live_jwt_ids < <(get_live_jwt_ids)

if (( ${#live_jwt_ids[@]} == 0 )); then
    development_settings="$(dirname "$jwt_project")/appsettings.Development.json"
    mapfile -t allowed_project_ids < <(
        jq -r '.Authorisation.AllowedGitlabProjectIds[]?' "$development_settings"
    )

    if (( ${#allowed_project_ids[@]} != 1 )); then
        echo "Expected exactly one development AllowedGitlabProjectId; found ${#allowed_project_ids[@]}." >&2
        exit 1
    fi

    echo "No live development JWT found; creating one." >&2
    # dotnet user-jwts requires an appsettings filename with a .json extension.
    temporary_appsettings=$(mktemp --suffix=.json)
    trap 'rm -f "$temporary_appsettings"' EXIT
    # Work on a copy: user-jwts rewrites its appsettings file when tokens are
    # created or removed, but our checked-in development trust settings must
    # remain stable.
    cp "$development_settings" "$temporary_appsettings"
    if ! dotnet user-jwts create \
        --project "$jwt_project" \
        --appsettings-file "$temporary_appsettings" \
        --claim "project_id=${allowed_project_ids[0]}" \
        --claim "ref_protected=true" \
        --role "observation_curator" \
        --output json >/dev/null; then
        echo "Failed to create development JWT." >&2
        exit 1
    fi

    mapfile -t live_jwt_ids < <(get_live_jwt_ids)
fi

if (( ${#live_jwt_ids[@]} != 1 )); then
    echo "Expected exactly one live JWT for $jwt_project; found ${#live_jwt_ids[@]}." >&2
    exit 1
fi

umask 077
token=$(dotnet user-jwts print "${live_jwt_ids[0]}" --project "$jwt_project" --output token)
printf 'DAVE_BENCHMARKS_TOKEN=%s\n' "$token" > "$jwt_env_file"
