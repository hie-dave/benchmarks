#!/usr/bin/env bash

set -euo pipefail

jwt_project=${1:-}
jwt_env_file=${2:-}

if [[ -z $jwt_project || -z $jwt_env_file ]]; then
    echo "Usage: $0 <project> <environment-file>" >&2
    exit 2
fi

now=$(date -u +%s)
tokens=$(dotnet user-jwts list --project "$jwt_project" --output json)
mapfile -t live_jwt_ids < <(
    jq -r --argjson now "$now" '
        .[]
        | select(
            (.NotBefore | sub("\\+00:00$"; "Z") | fromdateiso8601) <= $now
            and (.Expires | sub("\\+00:00$"; "Z") | fromdateiso8601) > $now
        )
        | .Id
    ' <<< "$tokens"
)

if (( ${#live_jwt_ids[@]} != 1 )); then
    echo "Expected exactly one live JWT for $jwt_project; found ${#live_jwt_ids[@]}." >&2
    exit 1
fi

umask 077
token=$(dotnet user-jwts print "${live_jwt_ids[0]}" --project "$jwt_project" --output token)
printf 'DAVE_BENCHMARKS_TOKEN=%s\n' "$token" > "$jwt_env_file"
