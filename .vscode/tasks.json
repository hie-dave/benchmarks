{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "prepare-cli-debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build",
                "write-local-jwt-environment"
            ],
            "problemMatcher": []
        },
        {
            "label": "write-local-jwt-environment",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/export-user-jwt",
                "${workspaceFolder}/src/Dave.Benchmarks.Web/Dave.Benchmarks.Web.csproj",
                "${workspaceFolder}/.vscode/.cli-debug.env"
            ],
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Dave.Benchmarks.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/Dave.Benchmarks.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/Dave.Benchmarks.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
