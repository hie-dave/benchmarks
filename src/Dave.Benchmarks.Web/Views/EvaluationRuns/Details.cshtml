@using Dave.Benchmarks.Core.Models.Entities
@using System.Text.Json
@model Dave.Benchmarks.Web.Models.EvaluationRunDetailsViewModel

@{
    ViewData["Title"] = $"Evaluation #{Model.Id}";
    var overview = JsonSerializer.Serialize(Model.Datasets.SelectMany(dataset => dataset.Results.Select(result => new
    {
        site = dataset.CandidateName,
        quantity = $"{result.CandidateVariable} / {result.CandidateLayer}",
        resultId = result.Id,
        metrics = result.Metrics.ToDictionary(metric => metric.Type, metric => metric.Value)
    })));
}

<div class="mb-3">
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-mergeRequestId="@Model.MergeRequestId">← Back to MR !@Model.MergeRequestId</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small">Sites</div><div class="fs-4 fw-semibold">@Model.Datasets.Count</div>
    </div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small">Comparisons</div><div class="fs-4 fw-semibold">@Model.ComparisonCount</div>
    </div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small">Without baseline</div><div class="fs-4 fw-semibold">@Model.DatasetCountWithoutBaseline</div>
        @if (Model.Passed == true && Model.DatasetCountWithoutBaseline > 0)
        {
            <div class="small text-muted">These comparisons pass because no baseline exists yet.</div>
        }
    </div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small">Unchanged from baseline</div><div class="fs-4 fw-semibold">@Model.UnchangedComparisonCount</div>
        <div class="small text-muted">Comparisons whose stored metrics are all unchanged.</div>
    </div></div></div>
</div>

@if (Model.ComparisonCount > 0 && Model.MetricTypes.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>At-a-glance metrics</strong><div class="small text-muted">Sites by evaluated quantity</div></div>
            <div class="d-flex align-items-center gap-2">
                <label for="overviewMetric" class="form-label mb-0 small">Metric</label>
                <select id="overviewMetric" class="form-select form-select-sm" style="width: auto">
                    @foreach (string metric in Model.MetricTypes)
                    {
                        <option value="@metric">@metric</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-body p-0"><div class="table-responsive" id="metricOverview"></div></div>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Evaluation #@Model.Id</h2>
        <div class="text-muted">@Model.BenchmarkName · submission #@Model.SubmissionId · pipeline @Model.PipelineId</div>
    </div>
    <span class="badge fs-6 @OutcomeClass(Model.Status, Model.Passed)">@OutcomeText(Model.Status, Model.Passed)</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger"><strong>Run error:</strong> @Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><div class="text-muted small">Merge request</div><strong>Project @Model.ProjectId · !@Model.MergeRequestId</strong></div>
            <div class="col-md-3"><div class="text-muted small">Branches</div><strong>@Model.SourceBranch → @Model.TargetBranch</strong></div>
            <div class="col-md-3"><div class="text-muted small">Started</div><strong>@Model.StartedAt.ToLocalTime().ToString("g")</strong></div>
            <div class="col-md-3"><div class="text-muted small">Duration</div><strong>@Duration(Model.StartedAt, Model.CompletedAt)</strong></div>
            <div class="col-12">
                <div class="text-muted small">Commit</div>
                <code>@Model.CommitSha</code>
                @if (!string.IsNullOrWhiteSpace(Model.CommitMessage))
                {
                    <span> · @Model.CommitMessage</span>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Datasets.Count == 0)
{
    <div class="alert alert-light border">This run contains no dataset results.</div>
}
else
{
    <div class="accordion" id="datasetResults">
        @for (var index = 0; index < Model.Datasets.Count; index++)
        {
            var dataset = Model.Datasets[index];
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(index == 0 ? "" : "collapsed")" type="button"
                            data-bs-toggle="collapse" data-bs-target="#dataset-@dataset.CandidateDatasetId">
                        <span class="me-2">@dataset.CandidateName</span>
                        <span class="badge @OutcomeClass(dataset.Status, dataset.Passed)">@OutcomeText(dataset.Status, dataset.Passed)</span>
                    </button>
                </h2>
                <div id="dataset-@dataset.CandidateDatasetId" class="accordion-collapse collapse @(index == 0 ? "show" : "")" data-bs-parent="#datasetResults">
                    <div class="accordion-body">
                        <div class="row mb-3 small">
                            <div class="col-md-4"><span class="text-muted">Simulation:</span> @dataset.SimulationId</div>
                            <div class="col-md-4"><span class="text-muted">Baseline:</span> @(dataset.BaselineName ?? "None")</div>
                            <div class="col-md-4"><span class="text-muted">Comparisons:</span> @dataset.Results.Count</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(dataset.ErrorMessage))
                        {
                            <div class="alert alert-danger">@dataset.ErrorMessage</div>
                        }
                        @if (dataset.Results.Count == 0)
                        {
                            <div class="text-muted">No comparable observation variables were found.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped align-middle">
                                    <thead><tr><th>Prediction</th><th>Observation</th><th>Metrics</th></tr></thead>
                                    <tbody>
                                    @foreach (var result in dataset.Results)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="Comparison" asp-route-id="@result.Id"><strong>@result.CandidateVariable</strong></a>
                                                <br /><span class="text-muted small">@result.CandidateLayer</span>
                                                @if (result.MetricsUnchangedFromBaseline == true)
                                                {
                                                    <br /><span class="badge text-bg-secondary">Unchanged</span>
                                                }
                                            </td>
                                            <td><strong>@result.ObservationDataset / @result.ObservationVariable</strong><br /><span class="text-muted small">@result.ObservationLayer</span></td>
                                            <td>
                                                @foreach (var metric in result.Metrics)
                                                {
                                                    <span class="badge text-bg-light border me-1"><strong>@metric.Type</strong> @FormatMetric(metric.Type, metric.Value)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (() => {
            const rows = @Html.Raw(overview);
            const host = document.getElementById('metricOverview');
            const select = document.getElementById('overviewMetric');
            if (!host || !select) return;
            const sites = [...new Set(rows.map(row => row.site))].sort();
            const quantities = [...new Set(rows.map(row => row.quantity))].sort();
            const escape = value => $('<div>').text(value).html();
            const format = (metric, value) => metric.toLowerCase() === 'n'
                ? Math.round(value).toLocaleString()
                : (Math.abs(value) >= 1000 || (value !== 0 && Math.abs(value) < 0.001)
                    ? value.toExponential(3) : value.toFixed(4).replace(/\.?0+$/, ''));
            function render() {
                const metric = select.value;
                let html = '<table class="table table-sm table-hover align-middle mb-0"><thead><tr><th class="ps-3">Site</th>';
                quantities.forEach(quantity => html += `<th>${escape(quantity)}</th>`);
                html += '</tr></thead><tbody>';
                sites.forEach(site => {
                    html += `<tr><th class="ps-3 text-nowrap">${escape(site)}</th>`;
                    quantities.forEach(quantity => {
                        const row = rows.find(item => item.site === site && item.quantity === quantity && item.metrics[metric] !== undefined);
                        html += row
                            ? `<td><a href="/EvaluationRuns/Comparison/${row.resultId}" class="text-decoration-none">${format(metric, row.metrics[metric])}</a></td>`
                            : '<td class="text-muted">—</td>';
                    });
                    html += '</tr>';
                });
                host.innerHTML = html + '</tbody></table>';
            }
            select.addEventListener('change', render);
            render();
        })();
    </script>
}

@functions {
    private static string Duration(DateTime started, DateTime? completed) => completed.HasValue
        ? (completed.Value - started).ToString(@"hh\:mm\:ss") : "—";
    private static string FormatMetric(string type, double value) => type.Equals("n", StringComparison.OrdinalIgnoreCase)
        ? Math.Round(value).ToString("N0")
        : Math.Abs(value) >= 1000 || (value != 0 && Math.Abs(value) < 0.001)
            ? value.ToString("0.###e+0") : value.ToString("0.####");
    private static string OutcomeText(EvaluationRunStatus status, bool? passed) => status switch
    {
        EvaluationRunStatus.Succeeded when passed == true => "Passed",
        EvaluationRunStatus.Succeeded => "Failed gate",
        EvaluationRunStatus.Failed => "Error",
        EvaluationRunStatus.Running => "Running",
        _ => "Pending"
    };
    private static string OutcomeClass(EvaluationRunStatus status, bool? passed) => status switch
    {
        EvaluationRunStatus.Succeeded when passed == true => "text-bg-success",
        EvaluationRunStatus.Succeeded => "text-bg-danger",
        EvaluationRunStatus.Failed => "text-bg-danger",
        EvaluationRunStatus.Running => "text-bg-primary",
        _ => "text-bg-secondary"
    };
}
